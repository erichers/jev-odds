# Copy to .env if you want a local note of the variables.
# The API reads environment variables and appsettings. It does not load this file on its own.
# docker compose up (SQLite, the zero-config default) does not need this file.
# Example passwords below are for a local database only. Do not put real secrets here.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# Database provider: Sqlite (default) or MySql.
Database__Provider=Sqlite
ConnectionStrings__Odds=Data Source=data/jev-odds.db

# MAMP MySQL on the host. Create the database jev_odds first, then use these instead of the SQLite lines.
# Port 8889 is the MAMP default. root / root is the usual MAMP example account.
# Database__Provider=MySql
# ConnectionStrings__Odds=Server=127.0.0.1;Port=8889;Database=jev_odds;User=root;Password=root;

# Docker Compose MySQL profile. Pass this file with: docker compose --profile mysql --env-file .env up --build
# DATABASE_PROVIDER=MySql
# ODDS_CONNECTION=Server=mysql;Port=3306;Database=jev_odds;User=jev;Password=jev
# MYSQL_DATABASE=jev_odds
# MYSQL_USER=jev
# MYSQL_PASSWORD=jev
# MYSQL_ROOT_PASSWORD=jev
# MYSQL_PORT=3306

Odds__CacheHours=12
Odds__YahooBaseUrl=https://query1.finance.yahoo.com
Odds__StooqBaseUrl=https://stooq.com
Odds__MonteCarloPaths=20000
Odds__MonteCarloSeed=184208
